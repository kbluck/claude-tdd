################################################################################
# A gitignore file specifies intentionally untracked files that Git shouldn't  #
# track by default. Each line in a gitignore file specifies a regex pattern.   #
# Any file with path and name matching the pattern is not tracked by default.  #
# You can still manually add and track files that match an ignore pattern, but #
# it is better to add a negative match for those using the ! operator.         #
#                                                                              #
# We generally add sets of patterns in sections according to the kinds of junk #
# created by different language tools, IDEs, editors, and operating systems.   #
# There is a Github repository with a collection of gitignore templates that   #
# provide a useful starting point to assemble these sections:                  #
# https://github.com/github/gitignore                                          #
#                                                                              #
# Full documentation about gitignore: https://git-scm.com/docs/gitignore       #
################################################################################

################################################################################
###                                 Project                                  ###
################################################################################

.mcp.json
.superpowers/
.tdd/checklist.json
