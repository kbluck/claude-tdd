+
+// ---------------------------------------------------------------------------
+// Bash dispatch: per-role command selection
+// ---------------------------------------------------------------------------
+
+test('guard: bash dispatch selects candidate command templates BY ROLE', () => {
+  const sandbox = makeSandbox();
+  try {
+    // Red's own "single" branch, independently of green's.
