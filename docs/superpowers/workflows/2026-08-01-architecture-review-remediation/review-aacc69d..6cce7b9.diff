-  || deny "tdd guard: .tdd/config.json is malformed (globs.test)"
-source_globs=$(jq -r '.globs.source | join(" ")' "$config" 2>/dev/null) \
-  || deny "tdd guard: .tdd/config.json is malformed (globs.source)"
-
